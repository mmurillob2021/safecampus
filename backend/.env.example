PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Firebase project (safecampus-3af06).
# FIREBASE_SERVICE_ACCOUNT turns on the live copy of incidents to Firestore, and makes
# npm run firestore:sync use firebase-admin (ignores Firestore rules). Without it, only the
# sync works, using the web config below, and only while the rules allow writes.
FIREBASE_PROJECT_ID="safecampus-3af06"
FIREBASE_API_KEY="your-web-api-key"
# FIREBASE_SERVICE_ACCOUNT="./firebase-service-account.json"

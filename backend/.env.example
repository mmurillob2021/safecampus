PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# Firebase project (safecampus-3af06), used by npm run firestore:sync.
# With FIREBASE_SERVICE_ACCOUNT the sync uses firebase-admin and ignores Firestore rules;
# without it, it uses the web config below and only works while the rules allow writes.
FIREBASE_PROJECT_ID="safecampus-3af06"
FIREBASE_API_KEY="your-web-api-key"
# FIREBASE_SERVICE_ACCOUNT="./firebase-service-account.json"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  SECURITY
  ADMIN
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

enum IncidentCategory {
  THEFT
  HARASSMENT
  SUSPICIOUS_ACTIVITY
  VANDALISM
  OTHER
}

enum IncidentStatus {
  PENDING
  REVIEWED
  RESOLVED
}

model User {
  id                String             @id @default(uuid())
  fullName          String
  email             String             @unique
  studentId         String?
  phone             String?
  passwordHash      String
  role              Role               @default(STUDENT)
  avatarUrl         String?
  createdAt         DateTime           @default(now())
  alerts            EmergencyAlert[]
  incidents         Incident[]
  personalContacts  PersonalContact[]
  notificationReads NotificationRead[]
}

model EmergencyAlert {
  id         String      @id @default(uuid())
  user       User        @relation(fields: [userId], references: [id])
  userId     String
  latitude   Float
  longitude  Float
  status     AlertStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?
}

model Incident {
  id          String           @id @default(uuid())
  user        User             @relation(fields: [userId], references: [id])
  userId      String
  category    IncidentCategory
  description String
  photoUrl    String?
  latitude    Float
  longitude   Float
  status      IncidentStatus   @default(PENDING)
  createdAt   DateTime         @default(now())
}

model OfficialContact {
  id    String @id @default(uuid())
  label String
  phone String
  order Int    @default(0)
}

model PersonalContact {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  name   String
  phone  String
}

model Notification {
  id        String             @id @default(uuid())
  title     String
  body      String
  createdAt DateTime           @default(now())
  reads     NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(uuid())
  notification   Notification @relation(fields: [notificationId], references: [id])
  notificationId String
  user           User         @relation(fields: [userId], references: [id])
  userId         String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}
